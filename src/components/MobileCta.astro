---
/**
 * Barra de conversión fija en móvil: aparece cuando el CTA del hero ya no se ve
 * y se esconde al llegar al formulario para no tapar contenido.
 */
import Phone from '@lucide/astro/icons/phone';
import Button from './ui/Button.astro';
import { site } from '../data/site';
---

<div class="mobile-cta" data-mobile-cta>
  <a class="mobile-cta__call" href={site.phoneHref} aria-label={`Llamar al ${site.phone}`}>
    <Phone size={20} />
  </a>
  <Button href="#contacto" block>
    Quiero mi revisión gratuita
  </Button>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const targets = document.querySelectorAll('#inicio, #contacto, footer');

  if (bar && targets.length && 'IntersectionObserver' in window) {
    const onScreen = new Set<Element>();

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) onScreen.add(entry.target);
        else onScreen.delete(entry.target);
      }
      bar.classList.toggle('is-visible', onScreen.size === 0);
    });

    targets.forEach((target) => observer.observe(target));
  }
</script>

<style lang="scss">
  @use '../styles/mixins' as *;

  .mobile-cta {
    position: fixed;
    z-index: 40;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem var(--gutter) calc(0.625rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--c-line);
    background: rgb(246 242 233 / 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    visibility: hidden;
    translate: 0 110%;
    transition:
      translate 0.35s var(--ease-out),
      visibility 0s 0.35s;

    &:global(.is-visible) {
      visibility: visible;
      translate: 0 0;
      transition: translate 0.35s var(--ease-out);
    }

    @include mq(md) {
      display: none;
    }
  }

  .mobile-cta__call {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1.5px var(--c-ink);
    color: var(--c-ink);
  }
</style>
