---
/**
 * Recurso visual del hero: una factura "desmontada" que señala dónde se pierde dinero.
 * Está hecha en HTML/CSS (no es una imagen): pesa casi nada, es nítida en cualquier
 * pantalla y su texto es legible por lectores de pantalla.
 */
import Search from '@lucide/astro/icons/search';
import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import { bill } from '../data/content';
import { eur } from '../utils/format';

const leaks = bill.lines.filter((line) => line.leak).length;
---

<figure class="bill">
  <div class="bill__sun" aria-hidden="true"></div>

  <p class="bill__chip">
    <Search size={15} stroke-width={2.5} />
    {leaks} mejoras detectadas
  </p>

  <div class="bill__paper">
    <div class="bill__head">
      <p class="bill__kicker">Factura de electricidad</p>
      <p class="bill__meta">
        {bill.period} · Tarifa {bill.tariff}
      </p>
    </div>

    <ul class="bill__lines" role="list">
      {bill.lines.map((line, i) => (
        <li class:list={['bill__line', { 'is-leak': line.leak }]} style={`--i: ${i}`}>
          <span class="bill__label">
            {line.label}
            {line.detail && <small>{line.detail}</small>}
          </span>
          <span class="bill__amount">{eur(line.amount)}</span>
          {line.leak && (
            <span class="bill__note">
              <TriangleAlert size={14} stroke-width={2.5} />
              {line.leak}
            </span>
          )}
        </li>
      ))}
    </ul>

    <div class="bill__total">
      <span class="bill__total-label">Total a pagar</span>
      <span class="bill__old">
        <span class="sr-only">Antes: </span>
        {eur(bill.before)}
      </span>
      <span class="bill__new">
        <span class="sr-only">Tras la revisión: </span>
        {eur(bill.after)}
      </span>
    </div>
  </div>

  <p class="bill__stamp">
    <strong>−{bill.yearlySaving}&nbsp;€</strong>
    <span>al año</span>
  </p>

  <figcaption class="bill__caption">
    Ejemplo ilustrativo de una factura doméstica revisada. El ahorro real depende de cada caso.
  </figcaption>
</figure>

<style lang="scss">
  @use '../styles/mixins' as *;

  .bill {
    position: relative;
    width: min(100%, 29rem);
    margin-inline: auto;
    padding-top: 1.5rem;
  }

  /* Sol de fondo: el acento amarillo de marca con dos halos */
  .bill__sun {
    position: absolute;
    top: -6%;
    right: -14%;
    width: 72%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c-volt);
    box-shadow:
      0 0 0 1.75rem rgb(255 210 63 / 0.22),
      0 0 0 3.5rem rgb(255 210 63 / 0.1);
  }

  .bill__chip {
    position: absolute;
    z-index: 2;
    top: 0.25rem;
    left: -0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    background: var(--c-ink);
    color: var(--c-volt);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
    rotate: -4deg;
    box-shadow: 0 10px 24px -12px rgb(14 35 32 / 0.8);

    @include mq(sm) {
      left: -1.25rem;
    }
  }

  .bill__paper {
    position: relative;
    z-index: 1;
    padding: 1.5rem 1.25rem 1.25rem;
    border: 1px solid rgb(14 35 32 / 0.06);
    border-radius: 1.25rem;
    background: var(--c-surface);
    box-shadow: var(--shadow-float);
    font-size: 0.875rem;

    @include mq(sm) {
      padding: 1.75rem 1.75rem 1.5rem;
    }

    @include mq(lg) {
      rotate: -2deg;
    }
  }

  .bill__head {
    padding-bottom: 0.9rem;
    padding-right: 5rem; // hueco para el sello
    border-bottom: 1px dashed var(--c-line-strong);
  }

  .bill__kicker {
    font-family: var(--f-display);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .bill__meta {
    margin-top: 0.2rem;
    color: var(--c-muted);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
  }

  .bill__lines {
    display: grid;
    gap: 0.125rem;
    margin-top: 0.625rem;
  }

  .bill__line {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1rem;
    margin-inline: -0.625rem;
    padding: 0.45rem 0.625rem;
    border-radius: var(--radius-sm);
    line-height: 1.35;

    &.is-leak {
      background: linear-gradient(var(--c-coral-soft), var(--c-coral-soft)) no-repeat left / 100%
        100%;
    }
  }

  .bill__label small {
    display: block;
    margin-top: 0.1rem;
    color: var(--c-muted);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
  }

  .bill__amount {
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .bill__note {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.3rem;
    color: var(--c-coral-text);
    font-size: 0.75rem;
    font-weight: 700;

    :global(svg) {
      flex: none;
    }
  }

  .bill__total {
    display: grid;
    grid-template-areas:
      'label old'
      'label new';
    grid-template-columns: 1fr auto;
    align-items: end;
    column-gap: 1rem;
    margin-top: 0.75rem;
    padding-top: 0.9rem;
    border-top: 2px solid var(--c-ink);
  }

  .bill__total-label {
    grid-area: label;
    font-weight: 700;
  }

  .bill__old {
    position: relative;
    grid-area: old;
    justify-self: end;
    color: var(--c-muted);
    font-family: var(--f-mono);
    font-size: 0.875rem;

    &::after {
      content: '';
      position: absolute;
      top: 50%;
      right: -3px;
      left: -3px;
      height: 2px;
      background: var(--c-coral);
      transform-origin: left;
    }
  }

  .bill__new {
    grid-area: new;
    justify-self: end;
    color: var(--c-leaf);
    font-family: var(--f-display);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .bill__stamp {
    position: absolute;
    z-index: 2;
    top: 0.5rem;
    right: -0.25rem;
    display: grid;
    place-content: center;
    width: 6.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--c-leaf);
    color: #fff;
    text-align: center;
    rotate: 12deg;
    outline: 2px dashed rgb(255 255 255 / 0.5);
    outline-offset: -7px;
    box-shadow: 0 14px 28px -12px rgb(22 112 74 / 0.8);

    strong {
      display: block;
      font-family: var(--f-display);
      font-size: 1.375rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      line-height: 1;
    }

    span {
      font-size: 0.75rem;
      font-weight: 600;
    }

    @include mq(sm) {
      right: -1.5rem;
    }
  }

  .bill__caption {
    position: relative;
    margin-top: 1.5rem;
    color: var(--c-muted);
    font-size: var(--fs-xs);
    text-align: center;
  }

  /* Secuencia de entrada: la factura aparece, se marcan las fugas,
     se tacha el total y aparece el sello de ahorro */
  @include motion {
    .bill__paper {
      animation: rise 0.9s var(--ease-out) 0.2s both;
    }

    .bill__chip {
      animation: pop-in 0.5s var(--ease-out) 0.7s both;
    }

    .bill__line.is-leak {
      animation: marker 0.6s var(--ease-out) both;
      animation-delay: calc(0.9s + var(--i) * 0.18s);
    }

    .bill__note {
      animation: fade 0.4s var(--ease-out) both;
      animation-delay: calc(1.1s + var(--i) * 0.18s);
    }

    .bill__old::after {
      animation: strike 0.45s var(--ease-out) 1.9s both;
    }

    .bill__new {
      animation: rise 0.5s var(--ease-out) 2.15s both;
    }

    .bill__stamp {
      animation: stamp 0.55s cubic-bezier(0.3, 1.5, 0.5, 1) 2.45s both;
    }
  }

  @keyframes strike {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes stamp {
    from {
      opacity: 0;
      scale: 1.7;
    }
  }

  @keyframes pop-in {
    from {
      opacity: 0;
      scale: 0.8;
    }
  }
</style>
