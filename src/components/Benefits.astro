---
import { benefits } from '../data/content';
---

<section class="benefits section" id="beneficios" aria-labelledby="benefits-title">
  <div class="container">
    <div class="section-head">
      <p class="kicker">Beneficios</p>
      <h2 class="section-title" id="benefits-title">
        Ahorro claro, sin letra pequeña.
      </h2>
      <p class="lead">
        Todo lo que necesitas para pagar lo justo por tu energía, y nada que no hayas pedido.
      </p>
    </div>

    <!-- Bento: 2 + 1 + 1 / 1 + 1 + 2 columnas en escritorio -->
    <ul class="bento" role="list">
      {benefits.map(({ icon: Icon, figure, title, text }, i) => (
        <li class={`benefit benefit--${i + 1}`} data-reveal style={`--reveal-i: ${i % 3}`}>
          {figure ? (
            <p class="benefit__figure" aria-hidden="true">
              {figure}
            </p>
          ) : (
            <span class="benefit__icon">
              <Icon size={24} />
            </span>
          )}
          <div>
            <h3 class="benefit__title">{title}</h3>
            <p class="benefit__text">{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style lang="scss">
  @use '../styles/mixins' as *;

  .bento {
    display: grid;
    gap: 1rem;

    @include mq(md) {
      grid-template-columns: repeat(2, 1fr);
    }

    @include mq(lg) {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .benefit {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    box-shadow:
      inset 0 0 0 1px var(--c-line),
      var(--shadow-card);

    /* En rejilla, las tarjetas comparten alto y el texto se ancla abajo */
    @include mq(md) {
      justify-content: space-between;
      gap: 2rem;
      min-height: 15rem;
    }
  }

  /* Tarjeta destacada: el argumento que más convierte, "gratis" */
  .benefit--1 {
    background: var(--c-volt);
    box-shadow: var(--shadow-card);

    .benefit__text {
      color: var(--c-ink);
    }
  }

  /* Tarjeta de cierre en oscuro para dar ritmo a la rejilla */
  .benefit--6 {
    --focus: var(--c-volt);

    background: var(--c-ink);
    color: var(--c-on-dark);
    box-shadow: var(--shadow-card);

    .benefit__icon {
      background: rgb(255 210 63 / 0.14);
      color: var(--c-volt);
    }

    .benefit__text {
      color: var(--c-on-dark-muted);
    }
  }

  .benefit--1,
  .benefit--6 {
    @include mq(md) {
      grid-column: span 2;
    }

    @include mq(lg) {
      flex-direction: row;
      align-items: flex-end;
    }
  }

  .benefit--6 {
    @include mq(lg) {
      align-items: center;
      justify-content: flex-start;
      gap: 1.75rem;
    }
  }

  .benefit__figure {
    font-family: var(--f-display);
    white-space: nowrap;
    font-size: clamp(4.5rem, 3rem + 6vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 0.85;

    @include mq(lg) {
      order: 2;
    }
  }

  .benefit__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius);
    background: var(--c-volt-soft);
  }

  .benefit__title {
    font-size: var(--fs-h3);
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .benefit__text {
    max-width: 38ch;
    margin-top: 0.625rem;
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }
</style>
