---
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import Phone from '@lucide/astro/icons/phone';
import Button from './ui/Button.astro';
import Logo from './ui/Logo.astro';
import { footerNav, site } from '../data/site';
import { withBase } from '../utils/url';

const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo withTagline />
        <p>
          Asesoría energética independiente para hogares, autónomos, empresas y comunidades de
          propietarios en toda España.
        </p>
        <Button href={withBase('/#contacto')} size="sm" arrow>
          Consulta gratuita
        </Button>
      </div>

      <nav class="footer__nav" aria-label="Pie de página">
        {footerNav.map((column) => (
          <div>
            <h2 class="footer__heading">{column.title}</h2>
            <ul role="list">
              {column.links.map((link) => (
                <li>
                  <a href={withBase(link.href)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}

        <div>
          <h2 class="footer__heading">Contacto</h2>
          <ul role="list" class="footer__contact">
            <li>
              <a href={site.phoneHref}>
                <Phone size={16} />
                {site.phone}
              </a>
            </li>
            <li>
              <a href={`mailto:${site.email}`}>
                <Mail size={16} />
                {site.email}
              </a>
            </li>
            <li>
              <MapPin size={16} />
              <span>
                {site.address.street}, {site.address.postalCode} {site.address.city}
              </span>
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>
        © {year} {site.legalName} · CIF {site.cif} · {site.address.street},{' '}
        {site.address.postalCode} {site.address.city}
      </p>
      <p>
        Inscrita en el Registro Mercantil de Madrid, tomo 00000, folio 000, hoja M-000000.{' '}
        <strong>
          Datos de empresa, contacto y legales simulados: web ficticia creada como prueba técnica.
        </strong>
      </p>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../styles/mixins' as *;

  .footer {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem) 2rem;
    border-top: 1px solid rgb(246 242 233 / 0.1);
    font-size: var(--fs-sm);
  }

  .footer__top {
    display: grid;
    gap: 3rem;
    padding-bottom: 3rem;

    @include mq(lg) {
      grid-template-columns: 0.9fr 1.6fr;
      gap: 4rem;
    }
  }

  .footer__brand {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 34ch;

    p {
      color: var(--c-on-dark-muted);
    }
  }

  .footer__nav {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;

    @include mq(md) {
      grid-template-columns: repeat(4, 1fr);
    }

    ul {
      display: grid;
      gap: 0.625rem;
      margin: 0;
    }

    a {
      color: var(--c-on-dark-muted);
      text-decoration: none;

      &:hover {
        color: var(--c-volt);
        text-decoration: underline;
      }
    }
  }

  .footer__heading {
    margin-bottom: 1rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer__contact {
    li,
    a {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
    }

    span {
      color: var(--c-on-dark-muted);
    }

    :global(svg) {
      flex: none;
      margin-top: 0.15rem;
      color: var(--c-volt);
    }
  }

  .footer__bottom {
    display: grid;
    gap: 0.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgb(246 242 233 / 0.12);
    color: var(--c-on-dark-muted);
    font-size: var(--fs-xs);

    strong {
      color: var(--c-on-dark);
      font-weight: 600;
    }

    @include mq(md) {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }
</style>
