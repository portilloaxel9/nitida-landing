---
/**
 * Curva de consumo hora a hora con los periodos de la tarifa 2.0TD.
 * Barras en HTML/CSS (sin librería de gráficos): se adaptan a cualquier ancho
 * sin que el texto encoja. Color = precio del periodo (rampa de un solo tono,
 * de claro/barato a oscuro/caro), reforzado con leyenda y textos.
 */
import Lightbulb from '@lucide/astro/icons/lightbulb';
import { hourlyUsage } from '../data/content';
import { decimal } from '../utils/format';

type Period = 'valle' | 'llano' | 'punta';

// Periodos 2.0TD en días laborables (península)
const periodOf = (hour: number): Period => {
  if (hour < 8) return 'valle';
  if ((hour >= 10 && hour < 14) || (hour >= 18 && hour < 22)) return 'punta';
  return 'llano';
};

const MAX_KWH = 1.2;
const data = hourlyUsage.map((kwh, hour) => ({ hour, kwh, period: periodOf(hour) }));
const total = hourlyUsage.reduce((sum, kwh) => sum + kwh, 0);
const share = (period: Period) =>
  Math.round(
    (data.filter((d) => d.period === period).reduce((sum, d) => sum + d.kwh, 0) / total) * 100,
  );
const peak = data.reduce((max, d) => (d.kwh > max.kwh ? d : max));

const legend: { period: Period; label: string; hours: string }[] = [
  { period: 'valle', label: 'Valle', hours: '0–8 h' },
  { period: 'llano', label: 'Llano', hours: '8–10, 14–18, 22–24 h' },
  { period: 'punta', label: 'Punta', hours: '10–14, 18–22 h' },
];

const summary = `Gráfico de barras del consumo por horas en un día laborable tipo. El ${share('punta')} % del consumo cae en horas punta, el ${share('llano')} % en llano y el ${share('valle')} % en valle. El pico es de ${decimal(peak.kwh)} kWh a las ${peak.hour} h.`;
---

<figure class="usage">
  <div class="usage__head">
    <div>
      <p class="usage__title">Tu consumo, hora a hora</p>
      <p class="usage__sub">Día laborable tipo · kWh por hora</p>
    </div>
    <span class="usage__tag">Ejemplo</span>
  </div>

  <div class="usage__plot" role="img" aria-label={summary}>
    <span class="usage__gridline" style="--y: 0.5">
      <span>0,5</span>
    </span>
    <span class="usage__gridline" style="--y: 1">
      <span>1 kWh</span>
    </span>
    <ol class="usage__bars">
      {data.map((d) => (
        <li
          class={`usage__col is-${d.period}`}
          style={`--v: ${d.kwh / MAX_KWH}`}
          data-tip={`${d.hour}–${d.hour + 1} h · ${decimal(d.kwh)} kWh`}
        >
          <span class="usage__bar" />
          {d === peak && <span class="usage__peak">Pico: {decimal(d.kwh)} kWh</span>}
        </li>
      ))}
    </ol>
  </div>

  <div class="usage__axis" aria-hidden="true">
    {[0, 8, 10, 14, 18, 22].map((h) => (
      <span style={`--h: ${h}`}>{h} h</span>
    ))}
  </div>

  <ul class="usage__legend" role="list">
    {legend.map((item) => (
      <li>
        <span class={`usage__swatch is-${item.period}`} aria-hidden="true" />
        <span>
          <strong>
            {item.label} · {share(item.period)} %
          </strong>
          <small>{item.hours}</small>
        </span>
      </li>
    ))}
  </ul>

  <figcaption class="usage__insight">
    <Lightbulb size={20} />
    <span>
      <strong>El {share('punta')} % de este consumo cae en horas punta</strong>, las más caras.
      Programar lavadora, lavavajillas o la carga del coche en horas valle abarata la factura sin
      renunciar a nada.
    </span>
  </figcaption>
</figure>

<style lang="scss">
  @use '../styles/mixins' as *;

  $gutter: 2.75rem; // espacio para las etiquetas del eje Y

  .usage {
    --focus: var(--c-ink);

    padding: clamp(1.25rem, 0.8rem + 2vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    color: var(--c-ink);
    box-shadow: var(--shadow-float);
  }

  .usage__head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .usage__title {
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .usage__sub {
    margin-top: 0.2rem;
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }

  .usage__tag {
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--c-paper-2);
    color: var(--c-muted);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .usage__plot {
    position: relative;
    height: clamp(10rem, 8rem + 8vw, 13rem);
    margin-top: 2.5rem;
  }

  .usage__gridline {
    position: absolute;
    right: 0;
    bottom: calc(var(--y) / #{1.2} * 100%);
    left: $gutter;
    border-top: 1px solid var(--c-paper-2);

    span {
      position: absolute;
      right: calc(100% + 0.5rem);
      translate: 0 -50%;
      color: var(--c-muted);
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      white-space: nowrap;
    }
  }

  .usage__bars {
    position: absolute;
    inset: 0 0 0 $gutter;
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 2px;
    padding: 0;
    border-bottom: 1px solid var(--c-line-strong);
    list-style: none;
  }

  .usage__col {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;

    &.is-valle {
      --bar: var(--c-valle);
    }

    &.is-llano {
      --bar: var(--c-llano);
    }

    &.is-punta {
      --bar: var(--c-punta);
    }

    /* Tooltip al pasar el ratón: hora exacta y kWh */
    &::after {
      content: attr(data-tip);
      position: absolute;
      z-index: 2;
      bottom: calc(var(--v) * 100% + 0.5rem);
      left: 50%;
      padding: 0.35rem 0.55rem;
      border-radius: 0.4rem;
      background: var(--c-ink);
      color: var(--c-paper);
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      white-space: nowrap;
      opacity: 0;
      pointer-events: none;
      translate: -50% 0.25rem;
      transition:
        opacity 0.15s,
        translate 0.15s;
    }

    &:nth-child(-n + 4)::after {
      left: 0;
      translate: 0 0.25rem;
    }

    &:nth-last-child(-n + 4)::after {
      right: 0;
      left: auto;
      translate: 0 0.25rem;
    }

    &:hover::after {
      opacity: 1;
      translate: -50% 0;
    }

    &:nth-child(-n + 4):hover::after,
    &:nth-last-child(-n + 4):hover::after {
      translate: 0 0;
    }
  }

  .usage__bar {
    width: min(100%, 1rem);
    height: calc(var(--v) * 100%);
    border-radius: 4px 4px 0 0;
    background: var(--bar);
    transition: opacity 0.15s;
  }

  .usage__bars:hover .usage__col:not(:hover) .usage__bar {
    opacity: 0.35;
  }

  .usage__peak {
    position: absolute;
    right: 0;
    bottom: calc(var(--v) * 100% + 0.45rem);
    color: var(--c-ink);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    white-space: nowrap;
    transition: opacity 0.15s;

    .usage__bars:hover & {
      opacity: 0;
    }
  }

  .usage__axis {
    position: relative;
    height: 1.5rem;
    margin-left: $gutter;

    span {
      position: absolute;
      top: 0.4rem;
      left: calc(var(--h) / 24 * 100%);
      color: var(--c-muted);
      font-family: var(--f-mono);
      font-size: 0.6875rem;
      white-space: nowrap;
      translate: -50% 0;
    }

    span:first-child {
      translate: 0 0;
    }
  }

  .usage__legend {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-paper-2);

    @include mq(sm) {
      grid-template-columns: repeat(3, 1fr);
    }

    li {
      display: flex;
      align-items: flex-start;
      gap: 0.55rem;
      font-size: var(--fs-xs);
      line-height: 1.35;
    }

    small {
      display: block;
      color: var(--c-muted);
      font-size: 0.75rem;
    }
  }

  .usage__swatch {
    flex: none;
    width: 0.75rem;
    height: 0.75rem;
    margin-top: 0.15rem;
    border-radius: 3px;

    &.is-valle {
      background: var(--c-valle);
    }

    &.is-llano {
      background: var(--c-llano);
    }

    &.is-punta {
      background: var(--c-punta);
    }
  }

  .usage__insight {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding: 1rem 1.125rem;
    border-radius: var(--radius);
    background: var(--c-volt-soft);
    font-size: var(--fs-sm);
    line-height: 1.5;

    :global(svg) {
      flex: none;
      margin-top: 0.1rem;
    }
  }

  @include motion {
    .usage__bar {
      transform-origin: bottom;
    }

    :global(.is-revealed) .usage__bar {
      animation: grow 0.8s var(--ease-out) both;
    }

    @for $i from 1 through 24 {
      :global(.is-revealed) .usage__col:nth-child(#{$i}) .usage__bar {
        animation-delay: #{0.2 + $i * 0.025}s;
      }
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
</style>
