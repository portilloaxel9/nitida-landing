---
/**
 * Logotipo: una lupa con un rayo ("revisamos tu energía") + palabra "nítida".
 * El trazo usa currentColor, así funciona igual sobre fondo claro u oscuro.
 */
interface Props {
  withTagline?: boolean;
}

const { withTagline = false } = Astro.props;
---

<span class="logo">
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="14" cy="14" r="11" fill="var(--c-volt)"></circle>
    <path
      d="M22.6 22.6 28.8 28.8"
      stroke="currentColor"
      stroke-width="3.4"
      stroke-linecap="round"
    ></path>
    <path d="M15.6 6.5 9.4 15h4.3l-1.2 6.5 6.3-8.6h-4.3z" fill="var(--c-ink)"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__word">nítida</span>
    {withTagline && <span class="logo__tagline">asesoría energética</span>}
  </span>
</span>

<style lang="scss">
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo__mark {
    width: 2rem;
    height: 2rem;
    flex: none;
  }

  .logo__text {
    display: grid;
  }

  .logo__word {
    font-family: var(--f-display);
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .logo__tagline {
    margin-top: 0.2rem;
    font-family: var(--f-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.75;
  }
</style>
