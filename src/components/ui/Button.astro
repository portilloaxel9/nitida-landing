---
/**
 * Botón de conversión. Se pinta como <a> si recibe href y como <button> si no.
 * Variantes: primary (amarillo, CTA principal) · dark · ghost.
 */
import type { HTMLAttributes } from 'astro/types';
import ArrowRight from '@lucide/astro/icons/arrow-right';

type Props = HTMLAttributes<'a'> &
  HTMLAttributes<'button'> & {
    variant?: 'primary' | 'dark' | 'ghost';
    size?: 'sm' | 'md' | 'lg';
    block?: boolean;
    arrow?: boolean;
  };

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  arrow = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block }, className]}
  {...rest}
>
  <span class="btn__label">
    <slot />
  </span>
  {arrow && <ArrowRight class="btn__icon" size={20} stroke-width={2.25} />}
</Tag>

<style lang="scss">
  .btn {
    --btn-bg: var(--c-volt);
    --btn-bg-hover: var(--c-volt-2);
    --btn-fg: var(--c-ink);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-height: 3rem;
    padding: 0.75rem 1.375rem;
    border: 0;
    border-radius: 999px;
    background: var(--btn-bg);
    color: var(--btn-fg);
    font-family: var(--f-body);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    box-shadow:
      inset 0 -2px 0 rgb(0 0 0 / 0.1),
      0 8px 20px -10px rgb(14 35 32 / 0.5);
    transition:
      background-color 0.2s,
      translate 0.2s var(--ease-out),
      box-shadow 0.2s;

    &:hover {
      background: var(--btn-bg-hover);
      translate: 0 -1px;
      box-shadow:
        inset 0 -2px 0 rgb(0 0 0 / 0.1),
        0 12px 24px -10px rgb(14 35 32 / 0.55);
    }

    &:active {
      translate: 0 0;
    }

    &[aria-busy='true'] {
      cursor: progress;
      opacity: 0.85;
    }
  }

  .btn--dark {
    --btn-bg: var(--c-ink);
    --btn-bg-hover: var(--c-ink-2);
    --btn-fg: var(--c-on-dark);
  }

  .btn--ghost {
    --btn-bg: transparent;
    --btn-bg-hover: rgb(14 35 32 / 0.06);
    --btn-fg: currentColor;

    box-shadow: inset 0 0 0 1.5px currentColor;

    &:hover {
      box-shadow: inset 0 0 0 1.5px currentColor;
    }
  }

  .btn--sm {
    min-height: 2.75rem;
    padding: 0.5rem 1.125rem;
    font-size: 0.9375rem;
  }

  .btn--lg {
    min-height: 3.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 1.0625rem;
  }

  .btn--block {
    width: 100%;
  }

  .btn__icon {
    flex: none;
    transition: translate 0.2s var(--ease-out);
  }

  .btn:hover .btn__icon {
    translate: 3px 0;
  }
</style>
