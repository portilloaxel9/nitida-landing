---
import { faqs } from '../data/content';
import { site } from '../data/site';
---

<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="container faq__grid">
    <div class="faq__intro">
      <p class="kicker">Preguntas frecuentes</p>
      <h2 class="section-title" id="faq-title">
        Las dudas que nos hacen antes de empezar.
      </h2>
      <p class="lead">
        ¿No encuentras la tuya? Llámanos al <a href={site.phoneHref}>{site.phone}</a> (
        {site.schedule}).
      </p>
    </div>

    <!-- <details> nativo: accesible sin JS; name="faq" hace que solo haya una abierta -->
    <div class="faq__list">
      {faqs.map((item, i) => (
        <details class="faq__item" name="faq" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <span class="faq__toggle" aria-hidden="true" />
          </summary>
          <p class="faq__answer">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style lang="scss">
  @use '../styles/mixins' as *;

  .faq__grid {
    display: grid;
    gap: 2.5rem;

    @include mq(lg) {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
      align-items: start;
    }
  }

  .faq__intro {
    @include mq(lg) {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    a {
      color: var(--c-ink);
      font-weight: 700;
      white-space: nowrap;
    }
  }

  .faq__list {
    border-top: 1px solid var(--c-line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--c-line-strong);

    /* Apertura animada donde el navegador lo soporta (mejora progresiva) */
    &::details-content {
      block-size: 0;
      overflow: clip;
      transition:
        block-size 0.35s var(--ease-out),
        content-visibility 0.35s allow-discrete;
    }

    &[open]::details-content {
      block-size: auto;
    }
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.375rem;
    cursor: pointer;
    font-family: var(--f-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    list-style: none;

    &::-webkit-details-marker {
      display: none;
    }

    &:hover .faq__toggle {
      background: var(--c-volt);
    }
  }

  /* Icono +/− dibujado con CSS */
  .faq__toggle {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--c-surface);
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
    transition:
      background-color 0.2s,
      rotate 0.3s var(--ease-out);

    &::before,
    &::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      width: 0.875rem;
      height: 2px;
      border-radius: 2px;
      background: var(--c-ink);
      translate: -50% -50%;
    }

    &::after {
      rotate: 90deg;
      transition: rotate 0.3s var(--ease-out);
    }

    [open] & {
      background: var(--c-ink);

      &::before,
      &::after {
        background: var(--c-volt);
      }

      &::after {
        rotate: 0deg;
      }
    }
  }

  .faq__answer {
    max-width: 62ch;
    padding-bottom: 1.5rem;
    color: var(--c-muted);
  }
</style>
