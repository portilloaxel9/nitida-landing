---
// Fuentes autoalojadas (Fontsource): sin peticiones a Google Fonts,
// mejor rendimiento y sin transferencias de datos a terceros (RGPD).
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.scss';

import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.legalName,
  description: site.description,
  url: Astro.site?.href,
  telephone: '+34900000000',
  email: site.email,
  priceRange: 'Gratis',
  areaServed: { '@type': 'Country', name: 'España' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: 'ES',
  },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#f6f2e9" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      // Marca que hay JS para poder animar sin penalizar a quien no lo tiene
      document.documentElement.classList.add('js');
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>

  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    <slot />

    <script>
      import { initReveal } from '../scripts/reveal';

      initReveal();
    </script>
  </body>
</html>
